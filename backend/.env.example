# OpenSearch (Huawei CSS) - las ES_* antiguas siguen funcionando como respaldo
OPENSEARCH_URL=https://10.0.0.205:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_CA_CERTS=
OPENSEARCH_TIMEOUT_S=30
OPENSEARCH_REPLICAS=

# Huawei ModelArts MaaS (LLM)
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_MODEL=glm-5.2
MAAS_REASONING_EFFORT=high # low|high|max (para glm-5.3+)
MAAS_EXTRA_BODY=

# Google Gemini (Inteligencia Atalaya)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_THINKING_LEVEL=medium # low|medium|high
GEMINI_TIMEOUT_S=45
GEMINI_GROUNDING_COOLDOWN_MIN=30
INTEL_GEMINI_DAILY_LIMIT=40
INTEL_MONITOR_COOLDOWN_MIN=15
INTEL_CAMPAIGN_TTL_H=72
INTEL_MONITOR_TTL_H=6

# Clave de operador (para investigar, regenerar y registrar decisiones)
ATALAYA_OPERATOR_TOKEN=

# ATALAYA application settings
ATALAYA_INDEX_PREFIX=atalaya-
ATALAYA_STORE=auto # auto|opensearch|memory
ATALAYA_LLM_ENABLED=1
ATALAYA_TARGET_YEAR=2027

