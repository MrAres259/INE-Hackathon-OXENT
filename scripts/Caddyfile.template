{
	admin off
	auto_https off
}

:{{PORT}} {
	log {
		output file "{{LOG}}" {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@admin path_regexp admin (?i)^/api/admin(/|$)
	handle @admin {
		respond 404
	}

	handle /api/* {
		reverse_proxy {{API}} {
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
			transport http {
				read_timeout 180s
			}
		}
	}

	handle {
		reverse_proxy {{WEB}}
	}
}
